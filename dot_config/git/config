[commit]
        gpgSign = true

[filter "lfs"]
        clean = "git-lfs clean -- %f"
        process = "git-lfs filter-process"
        required = true
        smudge = "git-lfs smudge -- %f"

[gpg]
        format = "openpgp"

[init]
        defaultBranch = "main"

[pull]
        rebase = true

[push]
        autoSetupRemote = true

[tag]
        gpgSign = true

