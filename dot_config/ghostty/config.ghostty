#font-family = "Monaspace Xenon"
font-family = "Monaspace Neon"
#theme = Catppuccin Mocha
background-opacity = 1

window-decoration = none
window-padding-balance = true
window-padding-x = 10
window-padding-y = 10

font-feature = calt
font-feature = case
#font-feature = cv02
#font-feature = cv11
font-feature = cv61
font-feature = cv62
font-feature = liga
font-feature = ss01
#font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09
font-feature = ss10
